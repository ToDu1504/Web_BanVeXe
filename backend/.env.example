# Sao chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
PORT=8080
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:8080

# Database — XAMPP (MariaDB 10.4) mặc định: root, mật khẩu rỗng, cổng 3306.
# Tên DB phải kết thúc bằng _dev hoặc _test thì các lệnh db:reset/db:seed/db:restore mới chạy.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bus_ticket_dev
DB_USER=root
DB_PASS=

# Sao lưu / khôi phục (npm run db:backup / db:restore)
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
MYSQL_PATH=C:\xampp\mysql\bin\mysql.exe
BACKUP_DIR=backups
BACKUP_KEEP=10

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Giữ chỗ hóa đơn pending
PENDING_INVOICE_TTL_MINUTES=30
CASH_HOLD_TTL_MINUTES=120
CASH_HOLD_DEPARTURE_BUFFER_MINUTES=30

# MoMo sandbox (bỏ trống để dùng thông tin sandbox công khai trong src/config/momo.config.js)
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:5173/payment/momo/return
MOMO_IPN_URL=http://localhost:8080/api/payments/momo/ipn

# Email (để trống SMTP_HOST/SMTP_USER thì mọi tính năng gửi mail tự tắt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_SKIP_DOMAINS=datvexekhach.vn,khachhang.vn
DEPARTURE_REMINDER_MINUTES=30
# Hạn dùng link quên mật khẩu (phút). Không có SMTP thì link được in ra console (chỉ khi NODE_ENV != production).
PASSWORD_RESET_TTL_MINUTES=30

# Xe trung chuyển (md/DonKhachTrungChuyen.md)
SHUTTLE_CUTOFF_MINUTES=120
SHUTTLE_PICKUP_LEAD_MINUTES=60
SHUTTLE_CHECK_INTERVAL_MS=60000
# Nút "Gửi mail" ở /staff/shuttles nhắc khách tự đến bến có mặt trước giờ chạy bao nhiêu phút
STATION_ARRIVE_EARLY_MINUTES=30
