{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API cho hệ thống bán vé xe khách - Node.js + Express + MySQL + Sequelize",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:create": "node src/scripts/createDb.js",
    "db:migrate": "node src/scripts/migrate.js up",
    "db:migrate:undo": "node src/scripts/migrate.js down",
    "db:status": "node src/scripts/migrate.js status",
    "db:seed": "node src/scripts/seedData.js",
    "db:seed-drivers": "node src/scripts/seedDrivers.js",
    "db:reset": "node src/scripts/resetDb.js",
    "db:backup": "node src/scripts/backupDb.js",
    "db:restore": "node src/scripts/restoreDb.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.14.0",
    "nodemailer": "^10.0.16",
    "sequelize": "^6.37.7",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "nodemonConfig": {
    "ignore": [
      "backups/*",
      "migrations/*"
    ]
  }
}
